  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <!-- Canvas mode files: CanvasFiles\ -> <exe folder>\Canvas\ after every
       build. robocopy instead of Content items: VS only lists wildcard
       items when the project loads, so files added later were missed.
       /XO = only copy files that are newer than the output copy, so pages
       edited next to the exe aren't overwritten. Exit codes 0-7 = OK. -->
  <Target Name="CopyCanvasFiles" AfterTargets="Build">
    <Exec Command="robocopy &quot;$(ProjectDir)CanvasFiles&quot; &quot;$(TargetDir)Canvas&quot; /E /XO /NFL /NDL /NJH /NJS /NP" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="CanvasCopyExit" />
    </Exec>
    <Error Condition="$(CanvasCopyExit) &gt;= 8" Text="Copying CanvasFiles to $(TargetDir)Canvas failed (robocopy exit $(CanvasCopyExit))" />
  </Target>
  <!-- Docs\ -> <exe folder>\doc\ after every build (Canvas page guide etc.).
       Docs are only edited in the project, so always overwrite (no /XO). -->
  <Target Name="CopyDocs" AfterTargets="Build">
    <Exec Command="robocopy &quot;$(ProjectDir)Docs&quot; &quot;$(TargetDir)doc&quot; /E /NFL /NDL /NJH /NJS /NP" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="DocsCopyExit" />
    </Exec>
    <Error Condition="$(DocsCopyExit) &gt;= 8" Text="Copying Docs to $(TargetDir)doc failed (robocopy exit $(DocsCopyExit))" />
  </Target>
</Project>